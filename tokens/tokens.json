{
  "$description": "GoodCart design tokens (W3C Design Tokens format). Source of truth: edit here, then run `npm run tokens` to regenerate tokens.css.",
  "color": {
    "$type": "color",
    "white": {
      "$value": "#FFFFFF",
      "$description": "Cards, popovers, inputs on canvas"
    },
    "canvas": {
      "$value": "#F7F4F2",
      "$description": "Page background, warm off-white"
    },
    "tint": {
      "$value": "#F4F0ED",
      "$description": "Subtle fills: secondary buttons, hovers, chips"
    },
    "tint-strong": {
      "$value": "#E8E3DF",
      "$description": "Active chips, selected nav, neutral badges"
    },
    "toggle": {
      "$value": "#EEEAE7",
      "$description": "Segmented control track"
    },
    "line": {
      "$value": "#E3E0DD",
      "$description": "Default borders and dividers"
    },
    "line-strong": {
      "$value": "#D0CCCA",
      "$description": "Hovered or emphasised borders"
    },
    "field": {
      "$value": "#C7C1BE",
      "$description": "Input borders"
    },
    "field-focus": {
      "$value": "#857F74",
      "$description": "Input border on focus"
    },
    "faint": {
      "$value": "#76726C",
      "$description": "Secondary text, placeholders (4.6:1 on white)"
    },
    "icon": {
      "$value": "#3A3429",
      "$description": "Icons, focus ring"
    },
    "dark": {
      "$value": "#1F1B14",
      "$description": "Primary buttons, dark surfaces, overlays"
    },
    "ink": {
      "$value": "#0A0907",
      "$description": "Primary text, warmest near-black"
    },
    "accent": {
      "$value": "#E83A2A",
      "$description": "Brand red, used sparingly: logo, new markers"
    },
    "red": {
      "$value": "#C4321F",
      "$description": "Destructive actions (AA on white)"
    },
    "success": {
      "$value": "#D3EBD5"
    },
    "success-ink": {
      "$value": "#24502C"
    },
    "warning": {
      "$value": "#F6E7C8"
    },
    "warning-ink": {
      "$value": "#6E4A0C"
    },
    "danger": {
      "$value": "#F8DCD8"
    },
    "danger-ink": {
      "$value": "#8E2A1E"
    },
    "night": {
      "$value": "#14110D",
      "$description": "Dark theme background (draft)"
    },
    "night-raised": {
      "$value": "#1F1B14",
      "$description": "Dark theme cards (draft)"
    },
    "night-line": {
      "$value": "#332D24",
      "$description": "Dark theme borders (draft)"
    },
    "night-faint": {
      "$value": "#A8A196",
      "$description": "Dark theme secondary text (draft)"
    },
    "paper": {
      "$value": "#F7F4F2",
      "$description": "Dark theme primary text (draft)"
    }
  },
  "semantic": {
    "$description": "Role-based colours. Components only use these, so a theme swap re-colours everything. Values reference color.*",
    "light": {
      "background": "{color.white}",
      "foreground": "{color.ink}",
      "canvas": "{color.canvas}",
      "card": "{color.white}",
      "card-foreground": "{color.ink}",
      "popover": "{color.white}",
      "popover-foreground": "{color.ink}",
      "primary": "{color.dark}",
      "primary-foreground": "{color.white}",
      "secondary": "{color.tint}",
      "secondary-foreground": "{color.ink}",
      "muted": "{color.tint}",
      "muted-foreground": "{color.faint}",
      "accent": "{color.tint}",
      "accent-foreground": "{color.ink}",
      "brand": "{color.accent}",
      "brand-foreground": "{color.white}",
      "destructive": "{color.red}",
      "destructive-foreground": "{color.white}",
      "success": "{color.success}",
      "success-foreground": "{color.success-ink}",
      "warning": "{color.warning}",
      "warning-foreground": "{color.warning-ink}",
      "danger": "{color.danger}",
      "danger-foreground": "{color.danger-ink}",
      "border": "{color.line}",
      "border-strong": "{color.line-strong}",
      "input": "{color.field}",
      "input-focus": "{color.field-focus}",
      "ring": "{color.icon}",
      "track": "{color.toggle}",
      "overlay": "{color.dark}"
    },
    "dark": {
      "background": "{color.night}",
      "foreground": "{color.paper}",
      "canvas": "{color.night}",
      "card": "{color.night-raised}",
      "card-foreground": "{color.paper}",
      "popover": "{color.night-raised}",
      "popover-foreground": "{color.paper}",
      "primary": "{color.paper}",
      "primary-foreground": "{color.dark}",
      "secondary": "{color.night-line}",
      "secondary-foreground": "{color.paper}",
      "muted": "{color.night-raised}",
      "muted-foreground": "{color.night-faint}",
      "accent": "{color.night-line}",
      "accent-foreground": "{color.paper}",
      "brand": "{color.accent}",
      "brand-foreground": "{color.white}",
      "destructive": "{color.accent}",
      "destructive-foreground": "{color.white}",
      "success": "{color.success-ink}",
      "success-foreground": "{color.success}",
      "warning": "{color.warning-ink}",
      "warning-foreground": "{color.warning}",
      "danger": "{color.danger-ink}",
      "danger-foreground": "{color.danger}",
      "border": "{color.night-line}",
      "border-strong": "{color.icon}",
      "input": "{color.icon}",
      "input-focus": "{color.night-faint}",
      "ring": "{color.night-faint}",
      "track": "{color.night-raised}",
      "overlay": "{color.night}"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Overused Grotesk",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem",
        "$description": "12px \u2014 captions, badges"
      },
      "sm": {
        "$value": "0.875rem",
        "$description": "14px \u2014 UI text, buttons"
      },
      "base": {
        "$value": "1rem",
        "$description": "16px \u2014 body"
      },
      "lg": {
        "$value": "1.125rem",
        "$description": "18px \u2014 lead paragraph"
      },
      "xl": {
        "$value": "1.25rem",
        "$description": "20px \u2014 card titles"
      },
      "2xl": {
        "$value": "1.5rem",
        "$description": "24px \u2014 h3"
      },
      "3xl": {
        "$value": "1.875rem",
        "$description": "30px \u2014 h2"
      },
      "4xl": {
        "$value": "2.25rem",
        "$description": "36px \u2014 h1"
      },
      "5xl": {
        "$value": "3rem",
        "$description": "48px \u2014 display"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.5rem",
      "$description": "Default (--radius)"
    },
    "xl": {
      "$value": "0.75rem"
    },
    "2xl": {
      "$value": "1rem",
      "$description": "Screenshot cards"
    },
    "full": {
      "$value": "9999px",
      "$description": "Pills: inputs, chips, nav, segmented controls"
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": {
      "$value": "0 1px 2px 0 rgb(31 27 20 / 0.05)"
    },
    "sm": {
      "$value": "0 1px 3px 0 rgb(31 27 20 / 0.08), 0 1px 2px -1px rgb(31 27 20 / 0.06)"
    },
    "md": {
      "$value": "0 4px 12px -2px rgb(31 27 20 / 0.08), 0 2px 4px -2px rgb(31 27 20 / 0.05)"
    },
    "lg": {
      "$value": "0 16px 40px -8px rgb(31 27 20 / 0.16), 0 4px 12px -4px rgb(31 27 20 / 0.06)"
    }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "out-quart": {
        "$value": [
          0.25,
          1,
          0.5,
          1
        ],
        "$description": "Default for UI transitions"
      },
      "out-quint": {
        "$value": [
          0.22,
          1,
          0.36,
          1
        ]
      },
      "out-expo": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "Large movements: sheets, modals"
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms",
        "$description": "Hover, colour"
      },
      "base": {
        "$value": "200ms",
        "$description": "Most transitions"
      },
      "slow": {
        "$value": "300ms",
        "$description": "Overlays, segmented thumb"
      }
    }
  }
}
