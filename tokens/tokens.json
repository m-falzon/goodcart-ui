{
  "$description": "GoodCart design tokens (W3C Design Tokens format). Source of truth: edit here, then run `npm run tokens` to regenerate tokens.css.",
  "color": {
    "$type": "color",
    "white": {
      "$value": "#FFFFFF",
      "$description": "Cards, popovers, inputs on canvas"
    },
    "canvas": {
      "$value": "#F9F6F4",
      "$description": "Page background, warm off-white"
    },
    "tint": {
      "$value": "#F4F0ED",
      "$description": "Subtle fills: secondary buttons, hovers, chips"
    },
    "tint-strong": {
      "$value": "#E8E3DF",
      "$description": "Active chips, selected nav, neutral badges"
    },
    "toggle": {
      "$value": "#EEEAE7",
      "$description": "Segmented control track"
    },
    "control": {
      "$value": "#EAE6E3",
      "$description": "Pill controls on canvas: search, filter triggers, icon buttons"
    },
    "control-strong": {
      "$value": "#E1DCD8",
      "$description": "Pill controls on hover"
    },
    "line": {
      "$value": "#E3E0DD",
      "$description": "Default borders and dividers"
    },
    "line-strong": {
      "$value": "#D0CCCA",
      "$description": "Hovered or emphasised borders"
    },
    "field": {
      "$value": "#C7C1BE",
      "$description": "Input borders"
    },
    "field-hover": {
      "$value": "#A8A29C",
      "$description": "Input border on hover; resting input icons"
    },
    "field-focus": {
      "$value": "#857F74",
      "$description": "Input border on focus (legacy; fields now focus to icon)"
    },
    "faint": {
      "$value": "#76726C",
      "$description": "Secondary text, placeholders (4.6:1 on white)"
    },
    "icon": {
      "$value": "#3A3429",
      "$description": "Icons, focus ring"
    },
    "icon-deep": {
      "$value": "#2E2A21",
      "$description": "Selected chips and filters on hover"
    },
    "dark": {
      "$value": "#1F1B14",
      "$description": "Primary buttons, dark surfaces, overlays"
    },
    "dark-raised": {
      "$value": "#433C30",
      "$description": "Primary buttons on hover"
    },
    "ink": {
      "$value": "#0A0907",
      "$description": "Primary text, warmest near-black"
    },
    "accent": {
      "$value": "#E83A2A",
      "$description": "Brand red, used sparingly: logo, new markers"
    },
    "red": {
      "$value": "#B8341A",
      "$description": "Destructive actions and error text (6:1 on canvas)"
    },
    "success": {
      "$value": "#D3EBD5"
    },
    "success-ink": {
      "$value": "#24502C"
    },
    "warning": {
      "$value": "#F6E7C8"
    },
    "warning-ink": {
      "$value": "#6E4A0C"
    },
    "danger": {
      "$value": "#F8DCD8"
    },
    "danger-ink": {
      "$value": "#8E2A1E"
    },
    "night": {
      "$value": "#14110D",
      "$description": "Dark theme background (draft)"
    },
    "night-raised": {
      "$value": "#1F1B14",
      "$description": "Dark theme cards (draft)"
    },
    "night-line": {
      "$value": "#332D24",
      "$description": "Dark theme borders (draft)"
    },
    "night-faint": {
      "$value": "#A8A196",
      "$description": "Dark theme secondary text (draft)"
    },
    "paper": {
      "$value": "#F7F4F2",
      "$description": "Dark theme primary text (draft)"
    }
  },
  "semantic": {
    "$description": "Role-based colours. Components only use these, so a theme swap re-colours everything. Values reference color.*",
    "light": {
      "background": "{color.white}",
      "foreground": "{color.ink}",
      "canvas": "{color.canvas}",
      "card": "{color.white}",
      "card-foreground": "{color.ink}",
      "popover": "{color.white}",
      "popover-foreground": "{color.ink}",
      "primary": "{color.dark}",
      "primary-foreground": "{color.white}",
      "primary-hover": "{color.dark-raised}",
      "selected": "{color.icon}",
      "selected-foreground": "{color.white}",
      "selected-hover": "{color.icon-deep}",
      "secondary": "{color.tint}",
      "secondary-foreground": "{color.ink}",
      "muted": "{color.tint}",
      "muted-foreground": "{color.faint}",
      "accent": "{color.tint}",
      "accent-foreground": "{color.ink}",
      "brand": "{color.accent}",
      "brand-foreground": "{color.white}",
      "destructive": "{color.red}",
      "destructive-foreground": "{color.white}",
      "success": "{color.success}",
      "success-foreground": "{color.success-ink}",
      "warning": "{color.warning}",
      "warning-foreground": "{color.warning-ink}",
      "danger": "{color.danger}",
      "danger-foreground": "{color.danger-ink}",
      "border": "{color.line}",
      "border-strong": "{color.line-strong}",
      "input": "{color.field}",
      "input-hover": "{color.field-hover}",
      "input-focus": "{color.icon}",
      "ring": "{color.icon}",
      "track": "{color.toggle}",
      "control": "{color.control}",
      "control-hover": "{color.control-strong}",
      "overlay": "{color.dark}"
    },
    "dark": {
      "background": "{color.night}",
      "foreground": "{color.paper}",
      "canvas": "{color.night}",
      "card": "{color.night-raised}",
      "card-foreground": "{color.paper}",
      "popover": "{color.night-raised}",
      "popover-foreground": "{color.paper}",
      "primary": "{color.paper}",
      "primary-foreground": "{color.dark}",
      "primary-hover": "{color.tint-strong}",
      "selected": "{color.paper}",
      "selected-foreground": "{color.dark}",
      "selected-hover": "{color.tint-strong}",
      "secondary": "{color.night-line}",
      "secondary-foreground": "{color.paper}",
      "muted": "{color.night-raised}",
      "muted-foreground": "{color.night-faint}",
      "accent": "{color.night-line}",
      "accent-foreground": "{color.paper}",
      "brand": "{color.accent}",
      "brand-foreground": "{color.white}",
      "destructive": "{color.accent}",
      "destructive-foreground": "{color.white}",
      "success": "{color.success-ink}",
      "success-foreground": "{color.success}",
      "warning": "{color.warning-ink}",
      "warning-foreground": "{color.warning}",
      "danger": "{color.danger-ink}",
      "danger-foreground": "{color.danger}",
      "border": "{color.night-line}",
      "border-strong": "{color.icon}",
      "input": "{color.icon}",
      "input-hover": "{color.night-faint}",
      "input-focus": "{color.night-faint}",
      "ring": "{color.night-faint}",
      "track": "{color.night-raised}",
      "control": "{color.night-line}",
      "control-hover": "{color.icon}",
      "overlay": "{color.night}"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Overused Grotesk",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    },
    "size": {
      "2xs": {
        "$value": "0.6875rem",
        "$description": "11px — eyebrows, overline labels"
      },
      "xs": {
        "$value": "0.75rem",
        "$description": "12px — captions, badges"
      },
      "meta": {
        "$value": "0.8125rem",
        "$description": "13px — card meta, toasts"
      },
      "sm": {
        "$value": "0.875rem",
        "$description": "14px — UI text, buttons"
      },
      "md": {
        "$value": "0.9375rem",
        "$description": "15px — dense body, menu rows on mobile"
      },
      "$type": "dimension",
      "base": {
        "$value": "1rem",
        "$description": "16px — body"
      },
      "lg": {
        "$value": "1.125rem",
        "$description": "18px — lead paragraph"
      },
      "xl": {
        "$value": "1.25rem",
        "$description": "20px — card titles"
      },
      "2xl": {
        "$value": "1.5rem",
        "$description": "24px — h3"
      },
      "3xl": {
        "$value": "1.875rem",
        "$description": "30px — h2"
      },
      "4xl": {
        "$value": "2.25rem",
        "$description": "36px — h1"
      },
      "5xl": {
        "$value": "3rem",
        "$description": "48px — display"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.5rem",
      "$description": "Default (--radius)"
    },
    "xl": {
      "$value": "0.75rem"
    },
    "2xl": {
      "$value": "1rem",
      "$description": "Screenshot cards"
    },
    "3xl": {
      "$value": "1.25rem",
      "$description": "20px — filter and sort menus"
    },
    "4xl": {
      "$value": "1.5rem",
      "$description": "24px — textareas, context menus"
    },
    "5xl": {
      "$value": "1.75rem",
      "$description": "28px — dialogs, sheets, account menu"
    },
    "full": {
      "$value": "9999px",
      "$description": "Pills: inputs, chips, nav, segmented controls"
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": {
      "$value": "0 1px 2px 0 rgb(31 27 20 / 0.05)"
    },
    "sm": {
      "$value": "0 1px 3px 0 rgb(31 27 20 / 0.08), 0 1px 2px -1px rgb(31 27 20 / 0.06)"
    },
    "md": {
      "$value": "0 4px 12px -2px rgb(31 27 20 / 0.08), 0 2px 4px -2px rgb(31 27 20 / 0.05)"
    },
    "lg": {
      "$value": "0 16px 40px -8px rgb(31 27 20 / 0.16), 0 4px 12px -4px rgb(31 27 20 / 0.06)"
    },
    "menu": {
      "$value": "0 0 0 1px rgb(58 52 41 / 0.06), 0 8px 32px rgb(58 52 41 / 0.08)",
      "$description": "Floating menus and popovers: hairline ring plus soft lift"
    },
    "overlay": {
      "$value": "0 16px 64px rgb(31 27 20 / 0.10)",
      "$description": "Sheets and context menus over content"
    },
    "focus": {
      "$value": "0 0 0 4px rgb(31 27 20 / 0.07)",
      "$description": "Soft halo on focused fields"
    },
    "focus-danger": {
      "$value": "0 0 0 4px rgb(184 52 26 / 0.12)",
      "$description": "Halo on focused invalid fields"
    },
    "toast": {
      "$value": "0 8px 24px -8px rgb(10 9 7 / 0.45)",
      "$description": "Dark toast pill"
    }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "out-quart": {
        "$value": [
          0.25,
          1,
          0.5,
          1
        ],
        "$description": "Default for UI transitions"
      },
      "out-quint": {
        "$value": [
          0.22,
          1,
          0.36,
          1
        ]
      },
      "out-expo": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "Large movements: sheets, modals"
      },
      "out-smooth": {
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ],
        "$description": "Gentle settle: hover lifts, image fades"
      },
      "drawer": {
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$description": "Sheets and drawers sliding in"
      },
      "in-quart": {
        "$value": [
          0.5,
          0,
          0.75,
          0
        ],
        "$description": "Exits: things leaving speed up"
      },
      "spring": {
        "$type": "string",
        "$value": "linear(0, 0.029, 0.103, 0.206, 0.325, 0.449, 0.57, 0.682, 0.781, 0.865, 0.934, 0.988, 1.028, 1.056, 1.073, 1.082, 1.083, 1.08, 1.073, 1.064, 1.054, 1.044, 1.034, 1.025, 1.017, 1.01, 1.005, 1, 0.997, 0.995, 0.994, 0.993, 0.993, 0.993, 0.994, 0.995, 0.996, 0.996, 0.997, 0.998, 1)",
        "$description": "Small overshoot for menus and pop-ins. Pair with a cubic-bezier fallback: `animation-timing-function: var(--ease-spring), ease-out`"
      }
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms",
        "$description": "Hover, colour"
      },
      "base": {
        "$value": "200ms",
        "$description": "Most transitions"
      },
      "slow": {
        "$value": "300ms",
        "$description": "Overlays, segmented thumb"
      }
    }
  }
}
