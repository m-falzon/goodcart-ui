{
  "name": "@goodcart/ui",
  "version": "0.1.0",
  "description": "GoodCart design system: tokens, Tailwind preset and React components",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "tokens",
    "assets",
    "src",
    "tailwind-preset.cjs",
    "registry.json"
  ],
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./fonts.css": "./assets/fonts.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./components/*": "./src/components/ui/*.tsx",
    "./utils": "./src/lib/utils.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && npm run registry:build && vite build",
    "preview": "vite preview",
    "tokens": "node scripts/build-tokens.mjs",
    "registry:build": "shadcn build --output docs/public/r && node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^2.10.0",
    "tailwindcss": "3.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
